# Building Code AI Assistant - Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Google AI API Configuration (required for Genkit/Gemini integration)
GOOGLE_GENAI_API_KEY=your_google_ai_api_key_here

# Optional: Application Configuration
APP_NAME=Building Code AI Assistant
APP_VERSION=1.0.0

# Optional: CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Optional: Logging Configuration
LOG_LEVEL=info

# Instructions:
# 1. Copy this file to .env
# 2. Get your Google AI API key from: https://makersuite.google.com/app/apikey
# 3. Replace 'your_google_ai_api_key_here' with your actual API key
# 4. Adjust other settings as needed for your environment